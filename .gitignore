# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Environment
.env
.env.local
*.env
secrets.env

# Logs
logs/
*.log

# Build output
frontend/dist/

# OS
.DS_Store
Thumbs.db

# Secrets
*.key
*.pem
*.crt
!config/nginx/*.conf

# Gateway data
gateway/logs/
gateway/extensions/*.py

# Provisioning output — generated configs contain live access tokens
provisioning/out/
# Per-site definitions may identify customer sites; keep the template only
provisioning/sites/*.json
!provisioning/sites/example.json
# Raw config dumps pulled from a gateway embed live access tokens — never commit
docker-compose_from_*.yml

# Backup
backups/

# Test coverage
.coverage
htmlcov/
.pytest_cache/

# Credential ledger + per-kit secrets produced by the migration wizard.
# out/ is already ignored; these patterns are belt-and-braces so a stray `git add -f`
# or a copy left elsewhere in the tree still cannot be committed.
credentials.csv
*.secrets.json
*.gw-mqtt.json
*.tb-revert.json

# Offline install artifacts are large vendor binaries. They are NOT committed - rebuild
# them with provisioning/migrate/fetch-artifacts.sh (see ARTIFACTS.md).
provisioning/migrate/cache/
*.img
*.img.zst
