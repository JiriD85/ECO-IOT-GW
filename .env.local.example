# Developer-machine settings for ECO-IOT-GW. Copy to `.env.local` (gitignored) and fill in.
# This file is ONLY for your local dev loop and for pushing builds to a test gateway.
# Production secrets live on the device in /etc/eco-iot-gw/secrets.env, generated by
# provisioning/setup-secrets.sh - never put those here.
#
# Nothing in this file is required to run the backend or frontend locally; it is needed
# only for the "deploy to a Pi over SSH" commands in CLAUDE.md.

# --- Test gateway you deploy to over SSH ---
# Export these before using the deploy snippets:
#   export PI_USER=... PI_HOST=... PI_PASSWORD=...
PI_USER=pi
PI_HOST=192.168.1.100
PI_PASSWORD=

# --- Local backend overrides (optional) ---
# The backend reads /etc/eco-iot-gw/secrets.env in production. In development it falls
# back to environment variables, so you can set throwaway values here. Do NOT reuse any
# real device secret.
# JWT_SECRET_KEY=dev-only-not-a-real-secret
# AES_ENCRYPTION_KEY=dev-only-not-a-real-secret
