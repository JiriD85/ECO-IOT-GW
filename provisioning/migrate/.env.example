# ECO migrate-box tool — unchanging credentials / config.
# Copy to `.env` (gitignored) and fill in. Per-run values (which kit, which box)
# are passed on the command line, NOT here.

# --- ThingsBoard (our tenant) ---
TB_BASE_URL=https://diagnostics.ecoenergygroup.com
TB_USERNAME=you@ecoenergygroup.com
TB_PASSWORD=

# --- MQTT endpoint the gateway connects to (NOT the REST host) ---
MQTT_HOST=lb-mqtt.pke-iot.expert
MQTT_PORT=1883

# --- Tailscale (box joins the tailnet with this) ---
# Use a tagged, reusable, ephemeral=false auth key.
TS_AUTHKEY=tskey-auth-

# --- Box SSH bootstrap ---
# The RESI fleet default login. Used ONCE to install our key, then we switch to
# key auth. The same vendor default is set on every RESI unit (users resi and root) -
# get it from the team's password manager. Never commit the value.
BOX_SSH_USER=resi
BOX_SSH_PASSWORD=
# Public+private key we install as ecoadmin and then authenticate with.
# Point at the PRIVATE key; the tool reads <path>.pub for the public half.
BOX_SSH_KEY=C:\Users\<you>\.ssh\eco-gw

# --- Docker (offline install, transferred over SCP) ---
# Path on THIS machine to the official static aarch64 engine tarball
# (download from https://download.docker.com/linux/static/stable/aarch64/).
DOCKER_STATIC_TGZ=
# Path on THIS machine to the tb-gateway arm64 image tar (docker save output),
# or leave blank to pull on the box.
TBGW_IMAGE_TAR=
TBGW_IMAGE_REF=thingsboard/tb-gateway:latest

# Raw RESI card image the wizard writes with --flash. Full-card image of the original
# RESI Doctor-Kit SD card; the wizard refuses to flash a disk smaller than the image.
RESI_IMAGE=C:/path/to/sd-card.img
