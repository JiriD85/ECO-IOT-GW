[Unit]
Description=ECO-IOT-GW Network Failover Daemon
Documentation=https://github.com/jiridockal/ECO-IOT-GW
After=network-online.target NetworkManager.service
Wants=network-online.target
Requires=NetworkManager.service

[Service]
Type=simple
User=eco-iot-gw
Group=eco-iot-gw
WorkingDirectory=/opt/eco-iot-gw/backend

# Wait for network to be fully online before starting
ExecStartPre=/bin/sleep 10

# Run failover daemon
ExecStart=/opt/eco-iot-gw/backend/venv/bin/python -m app.services.failover_daemon

# Restart on failure
Restart=always
RestartSec=10

# Resource limits
MemoryMax=256M
CPUQuota=10%

# Logging
StandardOutput=append:/var/log/eco-iot-gw/failover.log
StandardError=append:/var/log/eco-iot-gw/failover.log

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/eco-iot-gw /var/lib/eco-iot-gw

# Allow network configuration changes (needs CAP_NET_ADMIN for route changes)
# Note: nmcli requires sudo, configured in /etc/sudoers.d/eco-iot-gw
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
